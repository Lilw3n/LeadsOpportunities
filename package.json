{
  "name": "leads-opportunities",
  "private": true,
  "version": "1.0.0",
  "description": "Leads Opportunities website with Stripe serverless integration",
  "scripts": {
    "seo:build": "node scripts/build-france-cities-json.cjs && node scripts/generate-seo-pages.cjs",
    "niche:plan": "node -e \"console.log(require('fs').readFileSync('seo/niches.json','utf8'))\"",
    "niche:sync": "node -e \"require('fs').copyFileSync('seo/niches.json','data/niches-admin.json');console.log('niches-admin.json synced')\"",
    "blog:articles": "node scripts/generate-blog-articles.cjs",
    "blog:index": "node scripts/generate-blog-index.cjs",
    "blog:feed": "node scripts/generate-blog-feed.cjs",
    "blog:admin-map": "node scripts/generate-blog-admin-map.cjs",
    "blog:images": "node scripts/download-blog-images.cjs",
    "blog:build": "node scripts/generate-blog-articles.cjs --force && node scripts/generate-blog-index.cjs && node scripts/generate-blog-feed.cjs && node scripts/generate-blog-admin-map.cjs",
    "blog:actu:fetch": "node scripts/fetch-actu-candidates.cjs",
    "blog:actu:draft": "node scripts/draft-actu-articles.cjs",
    "blog:actu:status": "node scripts/blog-actu-status.cjs",
    "blog:actu:publish": "npm run blog:build && npm run seo:build",
    "blog:actu:daily": "node scripts/daily-actu-run.cjs",
    "blog:actu:archive": "node scripts/archive-actu-pending.cjs",
    "blog:actu:auto": "node scripts/auto-actu-publish.cjs",
    "blog:actu:verify-quality": "node scripts/verify-actu-quality.cjs",
    "build:clarity": "node scripts/bundle-clarity.cjs",
    "verify:clarity": "node scripts/verify-clarity.cjs",
    "verify:prod": "node scripts/verify-prod-readiness.cjs",
    "test:meta": "bash scripts/test-meta-pixel.sh",
    "meta:verify": "node scripts/verify-meta-lead-setup.cjs",
    "meta:forms:rank": "node scripts/meta-blog-form-ranking.cjs",
    "meta:forms:create": "node scripts/meta-blog-form-ranking.cjs && node scripts/meta-create-lead-forms.cjs --create",
    "meta:forms:replace": "node scripts/meta-blog-form-ranking.cjs && node scripts/meta-create-lead-forms.cjs --create --replace --fresh-names",
    "meta:campaigns:status": "node scripts/meta-campaigns-status.cjs",
    "meta:forms:plan": "node scripts/meta-blog-form-ranking.cjs && node scripts/meta-create-lead-forms.cjs --dry-run",
    "postinstall": "npm run build:clarity"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "@neondatabase/serverless": "^0.10.4",
    "imapflow": "^1.0.164",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.7.2",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
