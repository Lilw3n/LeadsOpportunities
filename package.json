{
  "name": "leads-opportunities",
  "private": true,
  "version": "1.0.0",
  "description": "Leads Opportunities website with Stripe serverless integration",
  "scripts": {
    "seo:build": "node scripts/build-france-cities-json.cjs && node scripts/generate-assurances-niches-page.cjs && node scripts/generate-seo-pages.cjs",
    "seo:images": "node scripts/download-seo-images.cjs",
    "verify:seo-vtc-idf": "node scripts/verify-seo-vtc-idf.cjs",
    "verify:seo-pret-recherche": "node scripts/verify-seo-pret-recherche.cjs",
    "verify:niches-dashboard": "node scripts/verify-niches-dashboard-redirect.cjs",
    "niche:plan": "node -e \"console.log(require('fs').readFileSync('seo/niches.json','utf8'))\"",
    "niche:sync": "node -e \"require('fs').copyFileSync('seo/niches.json','data/niches-admin.json');console.log('niches-admin.json synced')\"",
    "blog:articles": "node scripts/generate-blog-articles.cjs",
    "blog:index": "node scripts/generate-blog-index.cjs",
    "blog:feed": "node scripts/generate-blog-feed.cjs",
    "blog:admin-map": "node scripts/generate-blog-admin-map.cjs",
    "blog:images": "node scripts/download-blog-images.cjs",
    "blog:build": "node scripts/generate-blog-articles.cjs --force && node scripts/generate-blog-index.cjs && node scripts/generate-blog-feed.cjs && node scripts/generate-blog-admin-map.cjs",
    "blog:actu:fetch": "node scripts/fetch-actu-candidates.cjs",
    "blog:actu:draft": "node scripts/draft-actu-articles.cjs",
    "blog:actu:status": "node scripts/blog-actu-status.cjs",
    "blog:actu:publish": "npm run blog:build && npm run seo:build",
    "blog:actu:daily": "node scripts/daily-actu-run.cjs",
    "blog:actu:archive": "node scripts/archive-actu-pending.cjs",
    "blog:actu:auto": "node scripts/auto-actu-publish.cjs",
    "blog:actu:verify-quality": "node scripts/verify-actu-quality.cjs",
    "build:clarity": "node scripts/bundle-clarity.cjs",
    "verify:clarity": "node scripts/verify-clarity.cjs",
    "verify:gsc": "node scripts/verify-gsc-readiness.cjs",
    "gsc:urls": "node scripts/print-gsc-urls.cjs",
    "gsc:niches": "node scripts/print-gsc-niche-urls.cjs",
    "deploy:trigger": "node scripts/trigger-vercel-deploy.cjs",
    "verify:prod": "node scripts/verify-prod-readiness.cjs",
    "prod:check": "node scripts/check-prod-deploy.cjs",
    "test:meta": "bash scripts/test-meta-pixel.sh",
    "meta:verify": "node scripts/verify-meta-lead-setup.cjs",
    "meta:forms:rank": "node scripts/meta-blog-form-ranking.cjs",
    "meta:forms:create": "node scripts/meta-blog-form-ranking.cjs && node scripts/meta-create-lead-forms.cjs --create",
    "meta:forms:replace": "node scripts/meta-blog-form-ranking.cjs && node scripts/meta-create-lead-forms.cjs --create --replace --fresh-names",
    "meta:forms:plan": "node scripts/meta-blog-form-ranking.cjs && node scripts/meta-create-lead-forms.cjs --dry-run",
    "meta:vsp:discret": "node scripts/meta-vsp-discret-status.cjs",
    "meta:rotation:status": "node scripts/meta-campaign-rotation.cjs",
    "meta:rotation:build": "node scripts/meta-campaign-rotation.cjs --write",
    "postinstall": "npm run build:clarity",
    "pret:grilles:build": "node scripts/build-pret-grilles-catalog.cjs",
    "pret:grilles:import": "node scripts/import-pret-grilles.cjs",
    "pret:fiches:build": "node scripts/build-pret-fiches-catalog.cjs",
    "pret:fiches:import": "node scripts/import-pret-fiches.cjs",
    "pret:fiches:sync": "node scripts/sync-pret-fiches-download-list.cjs && node scripts/build-pret-fiches-catalog.cjs",
    "verify:listings": "node scripts/verify-immo-listings.cjs",
    "verify:listing-urls": "node scripts/verify-immo-listing-urls.cjs",
    "verify:projection": "node scripts/verify-achat-projection.cjs",
    "verify:questionnaires": "node scripts/verify-questionnaires-fields.cjs",
    "verify:leads-hub": "node scripts/verify-leads-hub.cjs",
    "verify:event-manager": "node scripts/verify-event-manager.cjs",
    "verify:relations": "node scripts/verify-people-relations.cjs",
    "verify:google-calendar": "node scripts/verify-google-calendar.cjs",
    "verify:interlocuteur": "node scripts/verify-interlocuteur-dossier.cjs",
    "verify:print-document": "node scripts/verify-print-document.cjs",
    "verify:slack": "node scripts/verify-slack-notify.cjs",
    "verify:canicule-mutuelle": "node scripts/verify-canicule-mutuelle.cjs"
  },
  "dependencies": {
    "@microsoft/clarity": "^1.0.2",
    "@neondatabase/serverless": "^0.10.4",
    "imapflow": "^1.0.164",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.7.2",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
