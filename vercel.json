{
  "redirects": [
    {
      "source": "/blog",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/landings",
      "destination": "/landings/index.html",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "leads-opportunities.vercel.app"
        }
      ],
      "destination": "https://www.leadsopportunities.fr/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "leadsopportunities.fr"
        }
      ],
      "destination": "https://www.leadsopportunities.fr/:path*",
      "permanent": true
    },
    {
      "source": "/niches/dashboard.html",
      "destination": "/dashboard.html",
      "permanent": false
    },
    {
      "source": "/niches/crm.html",
      "destination": "/crm.html",
      "permanent": false
    },
    {
      "source": "/niches/crm-acquisition.html",
      "destination": "/crm-acquisition.html",
      "permanent": false
    },
    {
      "source": "/niches/auth.html",
      "destination": "/auth.html",
      "permanent": false
    },
    {
      "source": "/niches/blog-questionnaires.html",
      "destination": "/blog-questionnaires.html",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/google-config-env",
      "destination": "/api/auth/google-config-env"
    },
    {
      "source": "/api/reviews-official-env",
      "destination": "/api/auth/reviews-official-env"
    },
    {
      "source": "/api/leads-recent",
      "destination": "/api/dashboard/leads-recent"
    },
    {
      "source": "/api/immo-network/:op",
      "destination": "/api/immo-network?op=:op"
    },
    {
      "source": "/api/mailbox/:path*",
      "destination": "/api/mailbox/:path*"
    },
    {
      "source": "/negociateur-immobilier",
      "destination": "/negociateur-immobilier/index.html"
    },
    {
      "source": "/negociateur-immobilier/",
      "destination": "/negociateur-immobilier/index.html"
    },
    {
      "source": "/bareme-honoraires",
      "destination": "/bareme-honoraires/index.html"
    },
    {
      "source": "/bareme-honoraires/",
      "destination": "/bareme-honoraires/index.html"
    },
    {
      "source": "/immobilier/location",
      "destination": "/immobilier/location/index.html"
    },
    {
      "source": "/immobilier/location/",
      "destination": "/immobilier/location/index.html"
    },
    {
      "source": "/immobilier/syndic",
      "destination": "/immobilier/syndic/index.html"
    },
    {
      "source": "/immobilier/syndic/",
      "destination": "/immobilier/syndic/index.html"
    },
    {
      "source": "/immobilier/visite",
      "destination": "/immobilier/visite.html"
    },
    {
      "source": "/immobilier/visite/",
      "destination": "/immobilier/visite.html"
    },
    {
      "source": "/agence-varangeville",
      "destination": "/agence-varangeville.html"
    },
    {
      "source": "/agence-varangeville/",
      "destination": "/agence-varangeville.html"
    },
    {
      "source": "/agence-varangeville/index.html",
      "destination": "/agence-varangeville.html"
    }
  ],
  "crons": [
    {
      "path": "/api/mailbox/cron-sync",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/mailbox/[action].js": {
      "maxDuration": 60
    },
    "api/dashboard/[action].js": {
      "maxDuration": 60
    },
    "api/webhooks/[action].js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/agence-varangeville",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/agence-varangeville/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/agence-varangeville.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/dashboard.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/crm.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/crm-leads.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/crm-events.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/crm-event-manager.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/crm-contact-modules.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/external/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    },
    {
      "source": "/crm-contact.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/auth.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/espace-client.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paiement.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/paiement-success.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/crm(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/niches",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/niches/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/seo/niches.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/data/niches-admin.json",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
