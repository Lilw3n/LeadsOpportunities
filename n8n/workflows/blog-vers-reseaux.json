{
  "name": "Blog vers réseaux",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * 1-5"
            }
          ]
        }
      },
      "id": "a1b2c3d4-1111-4111-8111-111111111111",
      "name": "Jours ouvres 10h",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://www.leadsopportunities.fr/social/queue.json",
        "options": {}
      },
      "id": "a1b2c3d4-2222-4222-8222-222222222222",
      "name": "Lire la file blog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [260, 0]
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.posted)) staticData.posted = [];\nconst body = $input.first().json || {};\nconst posts = Array.isArray(body.posts) ? body.posts : [];\nconst next = posts.find((post) => post && post.url && staticData.posted.indexOf(post.url) === -1);\nif (!next) {\n  return [{ json: { post: false, reason: 'Tous les articles de la file ont déjà été publiés.' } }];\n}\nreturn [{ json: Object.assign({ post: true }, next) }];"
      },
      "id": "a1b2c3d4-3333-4333-8333-333333333333",
      "name": "Choisir un article",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [520, 0]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.post }}",
              "value2": true
            }
          ]
        }
      },
      "id": "a1b2c3d4-4444-4444-8444-444444444444",
      "name": "Article a publier",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [780, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v21.0/{{ $json.facebookPageId }}/feed",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.message }}"
            },
            {
              "name": "link",
              "value": "={{ $json.link }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1b2c3d4-5555-4555-8555-555555555555",
      "name": "Publier sur la Page Facebook",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1060, -80],
      "credentials": {
        "httpQueryAuth": {
          "id": "facebook-page-token",
          "name": "Facebook Page token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nif (!Array.isArray(staticData.posted)) staticData.posted = [];\nconst chosen = $('Choisir un article').first().json;\nconst url = chosen.url;\nif (url && staticData.posted.indexOf(url) === -1) staticData.posted.push(url);\nreturn [{ json: { published: url, total: staticData.posted.length, facebook: $json } }];"
      },
      "id": "a1b2c3d4-6666-4666-8666-666666666666",
      "name": "Memoriser l article publie",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, -80]
    }
  ],
