# Clé locale pour chiffrer les identifiants dans n8n/data. Ne pas commiter n8n/.env.
# ./demarrer.sh ou ./serveur.sh en génère une si le fichier n8n/.env n'existe pas.
N8N_ENCRYPTION_KEY=remplacer-par-une-cle-longue-locale
# Sous-domaine du droplet. Inutile pour l'essai sur l'ordinateur.
N8N_HOST=n8n.leadsopportunities.fr
