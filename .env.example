# Stripe - cles privees (serveur)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# URLs publiques
NEXT_PUBLIC_APP_URL=https://www.leadsopportunities.fr

# Optionnel: identifiant interne d'entreprise pour metadata
COMPANY_CODE=LEADSOPP

# Optionnel: webhook pour recevoir les demandes (contact / devis) au format JSON (Zapier, Make, etc.)
LEAD_WEBHOOK_URL=

# Stockage des leads (Neon Postgres) — executer database/site_leads.sql sur la base puis :
DATABASE_URL=

# Notification email (https://resend.com — domaine expéditeur à verifier en prod)
RESEND_API_KEY=
# Plusieurs destinataires possibles (virgule). Par defaut contact@ est aussi ajoute (voir ci-dessous).
LEAD_NOTIFICATION_EMAIL=courtier972@gmail.com,contact@leadsopportunities.fr
# true = ajoute MAILBOX_ADDRESS aux notifs formulaire si pas deja dans la liste
LEAD_NOTIFY_INCLUDE_MAILBOX=true
LEAD_FROM_EMAIL=Leads Opportunities <contact@leadsopportunities.fr>
MAILBOX_FROM=Leads Opportunities <contact@leadsopportunities.fr>
MAILBOX_ADDRESS=contact@leadsopportunities.fr

# Messagerie dashboard (lecture IMAP o2switch + reponses Resend)
MAIL_IMAP_HOST=leadsopportunities.fr
MAIL_IMAP_PORT=993
MAIL_IMAP_USER=contact@leadsopportunities.fr
MAIL_IMAP_PASS=
# Sync auto : a chaque ouverture messagerie (8 min) + cron Vercel /15 min
MAILBOX_AUTO_SYNC=true
MAILBOX_AUTO_SYNC_MINUTES=8
CRON_SECRET=
# Certificat o2switch : TLS souple par defaut sur leadsopportunities.fr ; forcer strict : MAIL_IMAP_TLS_STRICT=true

# Token secret pour GET /api/leads-recent (tableau admin legacy)
LEADS_ADMIN_TOKEN=

# Webhook WithAllo (https://web.withallo.com/) — POST /api/webhooks/withallo
WITHALLO_WEBHOOK_SECRET=

# JWT secret pour l'authentification (OBLIGATOIRE en production, min 32 caracteres)
JWT_SECRET=

# Connexion Google (Google Cloud Console > APIs > Identifiants > OAuth 2.0)
# URI de redirection autorisee : https://www.leadsopportunities.fr/api/auth/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://www.leadsopportunities.fr

# Emails autorises en role admin (separes par des virgules)
ADMIN_EMAILS=courtier972@gmail.com

# Origines CORS autorisees pour les API (separees par des virgules)
ALLOWED_ORIGINS=https://www.leadsopportunities.fr

# --- Partenaires assurance (webhooks / API) — un par partenaire actif ---
# Voir config/partners.json pour la liste complete
PARTNER_NETVOX_WEBHOOK_URL=
PARTNER_ZEPHIR_ALIZE_WEBHOOK_URL=
PARTNER_ZEOLE_API_URL=
PARTNER_APRIL_API_KEY=
PARTNER_APRIL_API_BASE=
PARTNER_SOLLY_AZAR_WEBHOOK_URL=
PARTNER_ADDVALUE_WEBHOOK_URL=
PARTNER_XENASSUR_WEBHOOK_URL=
PARTNER_ENTORIA_API_KEY=
PARTNER_ENTORIA_API_BASE=
PARTNER_MATRISK_WEBHOOK_URL=
PARTNER_NOVELIA_API_KEY=
PARTNER_NOVELIA_API_BASE=
PARTNER_TETRIS_WEBHOOK_URL=
PARTNER_AMI3F_WEBHOOK_URL=
PARTNER_WELFAIRE_WEBHOOK_URL=

# Google Drive — dossier racine partage au compte courtier972@gmail.com
# Recommande : compte de service (JSON complet sur une ligne) + partage du dossier a client_email
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=
# Optionnel / test rapide seulement (expire ~1h) :
GOOGLE_DRIVE_ACCESS_TOKEN=

# Google Calendar — primary = agenda principal apres connexion CRM
GOOGLE_CALENDAR_DEFAULT_ID=primary

# Google (GA4 + Ads) : injectes dans le navigateur via GET /api/google-config-env
# Option recommandee sur Vercel : remplir ces variables plutot que editer google-config.js en dur.
# IDs publics (visibles dans le code page de toute facon), mais pratique pour ne pas committer.
GA4_MEASUREMENT_ID=
# Tag Google Ads (gtag config) : ex. AW-123456789
GOOGLE_ADS_ID=
# Libelles de conversion complets : ex. AW-123456789/AbCdEfGhIjKlMnOp
GOOGLE_ADS_CONVERSION_LEAD=
GOOGLE_ADS_CONVERSION_PHONE=
GOOGLE_ADS_CONVERSION_WHATSAPP=

# Social ads / pixels (optionnel mais recommande pour SEA social)
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
PINTEREST_TAG_ID=
