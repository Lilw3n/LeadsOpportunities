PARTNER_NETVOX_WEBHOOK_URL=
PARTNER_ZEPHIR_ALIZE_WEBHOOK_URL=
PARTNER_ZEOLE_API_URL=
# APRIL API Store (OAuth2 client_credentials) — secrets Vercel uniquement
PARTNER_APRIL_CLIENT_ID=
PARTNER_APRIL_CLIENT_SECRET=
# Gateways préprod doc API Store (sans slash final)
PARTNER_APRIL_GATEWAY=https://ppr-am-gateway.april.fr
PARTNER_APRIL_API_GATEWAY=https://ppr-api-gateway.april.fr
# Optionnel : URLs complètes si APRIL change de chemin
PARTNER_APRIL_OAUTH_URL=
PARTNER_APRIL_FIRST_CALL_URL=
PARTNER_APRIL_ENV=preprod
# Legacy (Bearer / X-Api-Key) — fallback si OAuth absent
PARTNER_APRIL_API_KEY=
PARTNER_APRIL_API_BASE=
PARTNER_SOLLY_AZAR_WEBHOOK_URL=
PARTNER_ADDVALUE_WEBHOOK_URL=
PARTNER_XENASSUR_WEBHOOK_URL=
PARTNER_ENTORIA_API_KEY=
PARTNER_ENTORIA_API_BASE=
PARTNER_MATRISK_WEBHOOK_URL=
PARTNER_NOVELIA_API_KEY=
PARTNER_NOVELIA_API_BASE=
PARTNER_TETRIS_WEBHOOK_URL=
PARTNER_AMI3F_WEBHOOK_URL=
PARTNER_WELFAIRE_WEBHOOK_URL=

# Google Drive — dossier racine partage au compte courtier972@gmail.com
# Uploads (photos, PDF) : GOOGLE_DRIVE_REFRESH_TOKEN obligatoire (OAuth Gmail perso)
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_USER_EMAIL=courtier972@gmail.com
GOOGLE_DRIVE_FOLDER_ID=19b0BAIySKxIDyc7ZTFwkp865Jk3nzs-Q
# Doublon sécurité : partager chaque upload avec contact@ (Workspace) + copie miroir optionnelle
GOOGLE_DRIVE_MIRROR=true
GOOGLE_DRIVE_MIRROR_EMAIL=contact@leadsopportunities.fr
GOOGLE_DRIVE_SHARE_EMAILS=courtier972@gmail.com,contact@leadsopportunities.fr
# Dossier Drive accessible en écriture par courtier972 (créé sur le Drive contact@ puis partagé)
GOOGLE_DRIVE_MIRROR_FOLDER_ID=
# Optionnel : compte de service (structure dossiers / liste — pas d'upload Gmail perso)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Test rapide seulement (expire ~1h) :
GOOGLE_DRIVE_ACCESS_TOKEN=

# Google Calendar — primary = agenda principal apres connexion CRM
GOOGLE_CALENDAR_DEFAULT_ID=primary

# Google (GA4 + Ads) : injectes dans le navigateur via GET /api/google-config-env
# Option recommandee sur Vercel : remplir ces variables plutot que editer google-config.js en dur.
# IDs publics (visibles dans le code page de toute facon), mais pratique pour ne pas committer.
GA4_MEASUREMENT_ID=
# Tag Google Ads (gtag config) : ex. AW-123456789
GOOGLE_ADS_ID=
# Libelles de conversion complets : ex. AW-123456789/AbCdEfGhIjKlMnOp
GOOGLE_ADS_CONVERSION_LEAD=
GOOGLE_ADS_CONVERSION_PHONE=
GOOGLE_ADS_CONVERSION_WHATSAPP=
# Conversion secondaire : lead qualifie (score serveur >= 50) — CPA cible recommande
GOOGLE_ADS_CONVERSION_QUALIFIED_LEAD=

# Social ads / pixels (optionnel mais recommande pour SEA social)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_CAPI_VERSION=v20.0
# Lead Ads webhook (formulaires instantanes Meta)
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=1183829618147455
META_AD_ACCOUNT_ID=997768686183548
TIKTOK_PIXEL_ID=
PINTEREST_TAG_ID=

# Microsoft Clarity — heatmaps + enregistrements session (gratuit)
# clarity.microsoft.com → Projet → Parametres → ID du projet
CLARITY_PROJECT_ID=x7yqp46fj9

# Twilio SMS — prêt mais DÉSACTIVÉ (aucun SMS = aucun frais).
# Remplir les 3 clés si tu crées un compte. Ne passe TWILIO_SMS_ENABLED à true
# que le jour où tu acceptes de payer ~0,08 $/SMS + ~1,15 $/mois le numéro.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_SMS_ENABLED=false
