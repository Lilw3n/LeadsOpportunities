# Stripe - cles privees (serveur)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx

# URLs publiques
NEXT_PUBLIC_APP_URL=https://www.leadsopportunities.fr

# Optionnel: identifiant interne d'entreprise pour metadata
COMPANY_CODE=LEADSOPP

# Optionnel: webhook pour recevoir les demandes (contact / devis) au format JSON (Zapier, Make, etc.)
LEAD_WEBHOOK_URL=

# Make.com — facturation électronique Tiime (parcours 0 €) — docs/MAKE-TIIME-EINVOICE.md
# Custom webhook Make (CRM → Make) + secret pour Make → POST /api/webhooks/make-einvoice
MAKE_EINVOICE_WEBHOOK_URL=
MAKE_EINVOICE_WEBHOOK_SECRET=

# Notion — tableau de bord factures (0 €) — docs/NOTION-EINVOICE.md
# Internal Integration Token + ID de la base « Facturation LO »
NOTION_TOKEN=
NOTION_EINVOICE_DATABASE_ID=

# Slack Incoming Webhook — alerte lead instantanée (plan gratuit OK)
# https://api.slack.com/messaging/webhooks — doc: docs/SLACK-WITHALLO-NOTIFS.md
SLACK_WEBHOOK_URL=

# Todoist — tâches depuis leads / CRM (docs/TODOIST.md)
# Jeton : app.todoist.com → Paramètres → Intégrations → Développeur
TODOIST_API_TOKEN=
# OAuth (optionnel) — https://developer.todoist.com/appconsole.html
# Redirect : https://www.leadsopportunities.fr/api/auth/todoist-callback
TODOIST_CLIENT_ID=
TODOIST_CLIENT_SECRET=
TODOIST_PROJECT_ID=

# Alerte Slack si baisse trafic (cron 9h /api/cron/traffic-alert)
TRAFFIC_ALERT_THRESHOLD_PCT=-20
TRAFFIC_ALERT_MIN_VISITORS=5
TRAFFIC_ALERT_COOLDOWN_HOURS=24
TRAFFIC_ALERT_ENABLED=true

# Stockage des leads (Neon Postgres) — executer database/site_leads.sql sur la base puis :
DATABASE_URL=

# Notification email (https://resend.com — domaine expéditeur à verifier en prod)
RESEND_API_KEY=
# Plusieurs destinataires possibles (virgule). Par defaut contact@ est aussi ajoute (voir ci-dessous).
LEAD_NOTIFICATION_EMAIL=courtier972@gmail.com,contact@leadsopportunities.fr
# true = ajoute MAILBOX_ADDRESS aux notifs formulaire si pas deja dans la liste
LEAD_NOTIFY_INCLUDE_MAILBOX=true
LEAD_FROM_EMAIL=Leads Opportunities <contact@leadsopportunities.fr>
MAILBOX_FROM=Leads Opportunities <contact@leadsopportunities.fr>
MAILBOX_ADDRESS=contact@leadsopportunities.fr

# Messagerie dashboard (lecture IMAP Workspace + secours o2switch + réponses Resend)
MAILBOX_WEBMAIL_URL=
MAILBOX_WEBMAIL_WORKSPACE_URL=https://mail.google.com/a/leadsopportunities.fr
MAILBOX_WEBMAIL_O2SWITCH_URL=https://sodium.o2switch.net:2096/3rdparty/roundcube/?_task=mail&_mbox=INBOX
# auto | workspace | o2switch | both — both = Workspace + o2switch (secours)
MAIL_IMAP_PROVIDER=both
MAIL_IMAP_USER=contact@leadsopportunities.fr
# Mot de passe d'application Google (Workspace → Sécurité → Mots de passe des applications)
MAIL_IMAP_PASS_WORKSPACE=
# Mot de passe boîte o2switch (garder pour bascule si abonnement Google stoppé)
MAIL_IMAP_PASS_O2SWITCH=
# Legacy : si seul MAIL_IMAP_PASS est défini, utilisé selon MAIL_IMAP_HOST
MAIL_IMAP_PASS=
MAIL_IMAP_HOST=mail.sodium.o2switch.net
MAIL_IMAP_HOST_O2SWITCH=mail.sodium.o2switch.net,sodium.o2switch.net
MAIL_IMAP_TLS_SERVERNAME=mail.sodium.o2switch.net
MAIL_IMAP_PORT=993
# Import historique o2switch (bouton « Historique o2switch ») — messages par lot
# MAIL_IMAP_BACKFILL_BATCH=40
# Messagerie : ne pas lancer la sync IMAP à l'ouverture de la liste (défaut false — bouton Sync)
# MAILBOX_LIST_AUTO_SYNC=true
# Sync auto : a chaque ouverture messagerie (8 min) + cron Vercel /15 min
MAILBOX_AUTO_SYNC=true
MAILBOX_AUTO_SYNC_MINUTES=8
CRON_SECRET=
# Certificat o2switch : TLS souple par defaut ; Workspace = imap.gmail.com strict
# MAIL_IMAP_TLS_STRICT=true

# Token secret pour GET /api/leads-recent (tableau admin legacy)
LEADS_ADMIN_TOKEN=

# Webhook WithAllo (https://web.withallo.com/) — POST /api/webhooks/withallo
WITHALLO_WEBHOOK_SECRET=
# Numero public temporaire WithAllo (affichage site / NAP) — E.164
# PUBLIC_PHONE_E164=+33971185399
# Affiche : 09 71 18 53 99 — doc: docs/SLACK-WITHALLO-NOTIFS.md

# JWT secret pour l'authentification (OBLIGATOIRE en production, min 32 caracteres)
JWT_SECRET=

# Connexion Google (Google Cloud Console > APIs > Identifiants > OAuth 2.0)
# URI de redirection autorisee : https://www.leadsopportunities.fr/api/auth/google-callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=https://www.leadsopportunities.fr

# Emails autorises en role admin (separes par des virgules)
ADMIN_EMAILS=courtier972@gmail.com

# Origines CORS autorisees pour les API (separees par des virgules)
ALLOWED_ORIGINS=https://www.leadsopportunities.fr

# --- Partenaires assurance (webhooks / API) — un par partenaire actif ---
